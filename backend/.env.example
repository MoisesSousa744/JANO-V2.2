# Configurações do Servidor JANO API
PORT=3000
NODE_ENV=development

# Segredo para assinatura de Tokens JWT
JWT_SECRET=jano_secret_key_super_segura_jwt_2026_etec_onboarding
JWT_EXPIRES_IN=8h

# Configurações do Banco de Dados MySQL (Deploy Render / Aiven / Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=jano_db

# Habilitar Fallback em Memória se o MySQL estiver offline durante desenvolvimento local
DB_FALLBACK_MEMORY=true

# Configuração Opcional para Envio Real de E-mail via Google (Gmail)
# Gere a senha em: Minha Conta Google > Segurança > Senhas de App (16 caracteres)
EMAIL_USER=sua-conta@gmail.com
EMAIL_PASS=sua_senha_de_app_de_16_digitos
APP_FRONTEND_URL=http://localhost:3000/login.html

# Alternativa via HTTPS (porta 443) caso a rede/firewall bloqueie portas SMTP (587/465):
# EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/SEU_ID/exec
# BREVO_API_KEY=sua_chave_api_brevo

